---
interface Props {
  compact?: boolean;
  lang?: 'es' | 'en';
}

const { compact = false, lang = 'es' } = Astro.props;
---

<aside
  class:list={['identity-badge', { 'identity-badge--compact': compact }]}
  aria-label={lang === 'en' ? 'Armando Andrés Meabe author badge' : 'Credencial de Armando Andrés Meabe'}
>
  <span class="identity-badge__slot" aria-hidden="true"></span>
  <span class="identity-badge__site">helloworld.com.ar</span>
  <img
    class="identity-badge__photo"
    src="/assets/armand.jpg"
    width="800"
    height="800"
    alt={lang === 'en' ? 'Portrait of Armando Andrés Meabe' : 'Retrato de Armando Andrés Meabe'}
  />
  <div class="identity-badge__name">
    <strong>Armando Andrés Meabe</strong>
    <span>{lang === 'en' ? 'software · architecture · notes' : 'software · arquitectura · notas'}</span>
  </div>
  <div class="identity-badge__meta">
    <span>AUTHOR</span>
    <span>HW-001</span>
  </div>
</aside>
