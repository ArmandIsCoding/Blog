---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { isVisiblePost, sortPosts } from '../lib/posts';

const posts = sortPosts((await getCollection('posts')).filter(isVisiblePost));
---

<BaseLayout description="Notas sobre software, desarrollo, arquitectura, inteligencia artificial y otros experimentos técnicos.">
  <div class="home-lede">
    <div>
      <p class="home-intro">
        Notas sobre software, desarrollo y las cosas que aprendí construyendo sistemas que parecían simples.
      </p>

      <blockquote class="home-motto">
        <i>“Todo sistema tiende a la entropía; documentar es una forma de rebeldía frente al olvido.”</i>
      </blockquote>
    </div>
    <img
      class="home-portrait"
      src="/assets/armand.jpg"
      width="800"
      height="800"
      alt="Retrato de Armando Andrés Meabe"
    />
  </div>

  <section aria-labelledby="ultimos-articulos">
    <h1 id="ultimos-articulos" class="section-heading">Últimos artículos</h1>
    <PostList posts={posts.slice(0, 12)} />
    {posts.length > 12 && (
      <p class="section-footer"><a href="/archivo/">Ver el archivo completo →</a></p>
    )}
  </section>

  <aside class="contact-note" aria-labelledby="hablemos">
    <div>
      <h2 id="hablemos">Hablemos</h2>
      <p>
        Podés encontrarme en
        <a href="https://github.com/ArmandIsCoding" target="_blank" rel="noopener noreferrer">GitHub</a>,
        <a href="https://www.linkedin.com/in/armandomeabe/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        y <a href="https://gravatar.com/armandomeabe" target="_blank" rel="noopener noreferrer">Gravatar</a>.
      </p>
    </div>
    <a class="contact-note__cv" href="/assets/cv-armando-meabe.pdf" download>
      ¿Trabajamos juntos?<br />
      <strong>Descargá mi CV →</strong>
    </a>
  </aside>
</BaseLayout>
