---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SiteLanguage } from '../lib/posts';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  lang?: SiteLanguage;
  alternateLanguagePaths?: Partial<Record<SiteLanguage, string>>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/social/default-og.png',
  type = 'website',
  noindex = false,
  jsonLd,
  lang = 'es',
  alternateLanguagePaths,
} = Astro.props;

const siteName = 'helloworld.com.ar';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(image, Astro.site);
const htmlLang = lang === 'en' ? 'en' : 'es-AR';
const ogLocale = lang === 'en' ? 'en_US' : 'es_AR';
const alternateLocale = lang === 'en' ? 'es_AR' : 'en_US';
const rssPath = lang === 'en' ? '/en/feed.xml' : '/feed.xml';
const skipLabel = lang === 'en' ? 'Skip to content' : 'Saltar al contenido';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternateLanguagePaths && Object.entries(alternateLanguagePaths).map(([alternateLang, path]) => (
      <link
        rel="alternate"
        hreflang={alternateLang === 'en' ? 'en' : 'es'}
        href={new URL(path, Astro.site)}
      />
    ))}
    {alternateLanguagePaths?.es && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternateLanguagePaths.es, Astro.site)} />
    )}
    <link rel="alternate" type="application/rss+xml" title={siteName} href={rssPath} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLanguagePaths?.[lang === 'en' ? 'es' : 'en'] && (
      <meta property="og:locale:alternate" content={alternateLocale} />
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{skipLabel}</a>
    <Header lang={lang} />
    <main id="contenido" class="page-shell">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
