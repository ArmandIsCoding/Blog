---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { isVisiblePost, slugifyTag } from '../../lib/posts';

const posts = (await getCollection('posts')).filter(isVisiblePost);
const tagCounts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort(([left], [right]) => left.localeCompare(right, 'es'));
---

<PageLayout title="Temas" description="Los asuntos que aparecen con más frecuencia en estas notas.">
  <ul class="project-list">
    {tags.map(([tag, count]) => (
      <li class="project">
        <h2><a href={`/temas/${slugifyTag(tag)}/`}>{tag}</a></h2>
        <div class="project__meta">{count} {count === 1 ? 'artículo' : 'artículos'}</div>
      </li>
    ))}
  </ul>
</PageLayout>
