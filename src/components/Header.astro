---
import type { SiteLanguage } from '../lib/posts';

interface Props {
  lang?: SiteLanguage;
}

const { lang = 'es' } = Astro.props;
const currentPath = Astro.url.pathname;

interface NavLink {
  href: string;
  label: string;
  language?: SiteLanguage;
}

const links: NavLink[] = lang === 'en'
  ? [
      { href: '/en/', label: 'Articles' },
      { href: '/en/feed.xml', label: 'RSS' },
      { href: '/', label: 'Español', language: 'es' },
    ]
  : [
      { href: '/archivo/', label: 'Archivo' },
      { href: '/temas/', label: 'Temas' },
      { href: '/proyectos/', label: 'Proyectos' },
      { href: '/acerca/', label: 'Acerca' },
      { href: '/feed.xml', label: 'RSS' },
      { href: '/en/', label: 'English', language: 'en' },
    ];

function isCurrentPath(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href={lang === 'en' ? '/en/' : '/'} aria-label={`helloworld.com.ar, ${lang === 'en' ? 'home' : 'inicio'}`}>
      hello, world<span aria-hidden="true">_</span>
    </a>
    <nav aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>
      <ul class="site-nav">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={{ 'site-nav__language': link.language }}
              hreflang={link.language}
              lang={link.language}
              aria-current={isCurrentPath(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
